      m_Calls: []
  m_text: '2 tablespoons vegetable oil

    4 cloves garlic, mince

    1 small onion,
    chopped

    1/2 cup carrot, chopped

    1/2 cup sliced mushroom

    4 cups
    water

    1/2 cup canned corn kernels

    2 sachets (8 g each) MAGGI Magic
    Sarap

    3 tablespoons cornstarch, dissolved in 3 tablespoons water

    1/2
    cup small shrimp, peeled and deveined

    12 pieces quail egg, boiled and peeled

    2
    tablespoons sliced spring onion

'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 90c94f9c06924c7478f1ecd954929b1f, type: 2}
  m_sharedMaterial: {fileID: -988498651693161367, guid: 90c94f9c06924c7478f1ecd954929b1f, type: 2}
