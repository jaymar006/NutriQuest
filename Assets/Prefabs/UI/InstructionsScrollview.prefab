  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1. Heat vegetable oil in a pot over medium heat. Saut\xE9 garlic and onion
    until fragrant.\n\r\n2. Add chopped carrot and sliced mushroom. Cook for a few
    minutes until slightly softened.\n\r\n3. Pour in water and bring to a boil, then
    add the corn kernels.\n\r\n4. Season with MAGGI Magic Sarap and mix well.\n\r\n5.
    Stir in the cornstarch mixture and simmer until the soup slightly thickens.\n\r\n6.
    Add the shrimp and cook just until they turn pink and are cooked through.\n\r\n7.
    Add the quail eggs and sliced spring onion, then turn off the heat."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 90c94f9c06924c7478f1ecd954929b1f, type: 2}
  m_sharedMaterial: {fileID: -988498651693161367, guid: 90c94f9c06924c7478f1ecd954929b1f, type: 2}
