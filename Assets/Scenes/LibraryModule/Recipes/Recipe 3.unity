  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1. Place the chicken ham in a pan and fry until light brown, then set
    aside.\r\n\r\n2. In the same pan, add 1\u20132 tablespoons vegetable oil and
    the egg, and cook into a scrambled egg; set aside.\n\r\n3. Toast the bread using
    an electric grill until browned, then set aside.\n\r\n4. To assemble, spread
    mayonnaise on the first slice of bread.\n\r\n5. Add ham, then lettuce, scrambled
    egg, and tomatoes.\r\n\r\n6. Place the second slice of bread (spread with mayonnaise)
    on top. Add lettuce, cheese squares, scrambled egg, and sliced cucumber, then
    cover with the third slice of bread.\n\r\n7. Insert toothpicks on each side to
    hold the layers, then cut into 4 pieces."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 90c94f9c06924c7478f1ecd954929b1f, type: 2}
  m_sharedMaterial: {fileID: -988498651693161367, guid: 90c94f9c06924c7478f1ecd954929b1f, type: 2}
