MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 949067928}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5c4e49120649a1b4ca7c4060bed01c58, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuestionGeneratorBeta
  questions:
  - question: Which of the following is a healthy food that comes from plants?
    answerA: 'A. Hotdog '
    answerB: B. Banana
    answerC: C, Candy
    answerD: D. Soda
    correctAnswer: 'B '
  - question: Which is a junk food high in sugar?
    answerA: 'A. Spinach '
    answerB: B. Chocolate bar
    answerC: C. Rice
    answerD: D. Chicken
    correctAnswer: 'B '
  - question: Which is an example of a healthy food in the Pinggang Pinoy?
    answerA: 'A. Ice cream '
    answerB: B. Eggplant
    answerC: C. French fries
    answerD: D. Cake
    correctAnswer: 'B '
  - question: 'Which is the healthiest drink for kids? '
    answerA: A. Milk
    answerB: B. Soda
    answerC: C. Energy drink
    answerD: D. Sweetened juice
    correctAnswer: A
  - question: 'Which food is less healthy because it is high in fat? '
    answerA: A. Fish
    answerB: 'B. Fried chicken '
    answerC: 'C. Sweet potato '
    answerD: 'D. Corn '
    correctAnswer: B
  - question: 'Which food is a healthy "Go" food in the Food Pyramid? '
    answerA: A. Cupcake
    answerB: 'B. Rice '
    answerC: 'C. Pork rinds '
    answerD: 'D. Donut '
    correctAnswer: B
  - question: 'Which food is rich in vitamin C, good for immunity? '
    answerA: A. Lollipop
    answerB: B. Orange
    answerC: C.. Biscuit
    answerD: 'D. Soda '
    correctAnswer: B
  - question: 'Which is a junk food that should be avoided? '
    answerA: 'A. Watermelon '
    answerB: B. Potato chips
    answerC: 'C. Egg '
    answerD: 'D. Mung beans '
    correctAnswer: B
  - question: 'Which is a healthy food that comes from animals? '
    answerA: A. Hotdog
    answerB: B. Fish
    answerC: 'C. Candy bar '
    answerD: D. Ice cream
    correctAnswer: B
  - question: Which is a healthy snack for kids?
    answerA: A. Sticky rice (suman)
    answerB: B. Chocolate syrup
    answerC: 'C. Sweet bread '
    answerD: D. Instant Noodle
    correctAnswer: A
  delayBeforeNextQuestion: 1
