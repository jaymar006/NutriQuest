  - character: {fileID: 166775541}
    useCustomSpeakerName: 1
    customSpeakerName: Sienna
    dialogueText: I cannot go inside myself because I need to stay here and monitor
      the magical arrays to make sure nothing gets worse.
    useItalic: 0
    useBold: 0
    emotionPortrait: {fileID: -7564531368924530369, guid: a160d0077108791478aa9c2b5a03f01b, type: 3}
