    dialogueText: Fix the tower AND bring back my pages. That is all I ask!
    useItalic: 0
    useBold: 0
    emotionPortrait: {fileID: -2101606179557248710, guid: 3bbc0cd91b4224547a3088bffc13f955, type: 3}
