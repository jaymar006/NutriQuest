  m_Script: {fileID: 11500000, guid: 86783829ccb3a504386c9251950a684b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Gameplay.CutsceneManager.DialogueManager
  dialoguePanel: {fileID: 2820461253994465100}
  nameBox: {fileID: 1593566180028779488}
  textBox: {fileID: 1522056495660515805}
  continueIndicator: {fileID: 0}
  textScrollRect: {fileID: 0}
  allCharacters:
  - {fileID: 2068079846}
  sceneVisualsRoot: {fileID: 547247310}
  blackScreenImage: {fileID: 371549825}
  fadeDuration: 1
  audioSource: {fileID: 0}
  typingSFXSource: {fileID: 0}
  defaultTypingSFX: {fileID: 8300000, guid: c9445f10fa381124a9382c92034721e9, type: 3}
  typingSFXInterval: 3
  stopSFXOnSkip: 1
  nameInputScreen: {fileID: 0}
  typingSpeed: 0.02
  slideDistance: 200
  portraitContainer: {fileID: 469297851}
  dialogueLines:
  - character: {fileID: 0}
    useCustomSpeakerName: 0
    customSpeakerName: ???
    dialogueText: Woah! You actually cleared Tower 1! Not bad for someone who just
      got here!
    filipinoText: Woah! Natapos mo talaga ang Tower 1! Hindi masama para sa isang
      kararating pa lang!
    useItalic: 0
    useBold: 0
    emotionPortrait: {fileID: 8495209843170342830, guid: 0e0ac28be41d94e4eb10c24caaadbc20, type: 3}
    entranceType: 2
    entranceDuration: 0
    enableReaction: 0
    reactionDuration: 0
    reactionScaleTarget: 0
    enableShake: 0
    shakeIntensity: 0
    shakeDuration: 0
    outroType: 0
    outroDuration: 0
    customEntranceClip: {fileID: 0}
    optionalUIImage: {fileID: 0}
    soundClip: {fileID: 0}
    typingSFX: {fileID: 0}
    useBlackScreen: 0
    excludeDialogueBoxFromBlackout: 0
    hideDialoguePanel: 0
    openNameInputAfterThisLine: 0
  - character: {fileID: 0}
    useCustomSpeakerName: 0
    customSpeakerName: ???
    dialogueText: Oh! I forgot to introduce myself.
    filipinoText: HALA! Hindi pala ako nakapagpakilala.
    useItalic: 0
    useBold: 0
    emotionPortrait: {fileID: -6077793430231951356, guid: 55166d42aba58dc47ad2f2f79e4ca59d, type: 3}
    entranceType: 0
    entranceDuration: 0
    enableReaction: 0
    reactionDuration: 0
    reactionScaleTarget: 0
    enableShake: 0
    shakeIntensity: 0
    shakeDuration: 0
    outroType: 0
    outroDuration: 0
    customEntranceClip: {fileID: 0}
    optionalUIImage: {fileID: 0}
    soundClip: {fileID: 0}
    typingSFX: {fileID: 0}
    useBlackScreen: 0
    excludeDialogueBoxFromBlackout: 0
    hideDialoguePanel: 0
    openNameInputAfterThisLine: 0
  - character: {fileID: 0}
    useCustomSpeakerName: 0
    customSpeakerName: Emby
    dialogueText: I'm Emby! Knight in training, future hero, and Sienna's oldest
      friend!
    filipinoText: Ako si Emby! Isang knight na nagsasanay pa lang, magiging bayani
      balang araw, at pinakamatagal nang kaibigan ni Sienna!
    useItalic: 0
    useBold: 0
    emotionPortrait: {fileID: 21300000, guid: 1077e0627b8da5f44bb82b1ccf6fecf2, type: 3}
    entranceType: 0
    entranceDuration: 0
    enableReaction: 0
    reactionDuration: 0
    reactionScaleTarget: 0
    enableShake: 0
    shakeIntensity: 0
    shakeDuration: 0
    outroType: 0
    outroDuration: 0
    customEntranceClip: {fileID: 0}
    optionalUIImage: {fileID: 0}
    soundClip: {fileID: 0}
    typingSFX: {fileID: 0}
    useBlackScreen: 0
    excludeDialogueBoxFromBlackout: 0
    hideDialoguePanel: 0
    openNameInputAfterThisLine: 0
  - character: {fileID: 0}
    useCustomSpeakerName: 0
    customSpeakerName: Emby
    dialogueText: I came inside to investigate why the tower locked but honestly...
      I got distracted by something...
    filipinoText: Pumasok ako rito para alamin kung bakit nakakandado ang tore pero
      sa totoo lang... may ibang bagay na nakakuha ng atensyon ko...
    useItalic: 0
    useBold: 0
    emotionPortrait: {fileID: 4613369332385885323, guid: c38f36071605f5c4da5011c8238f182b, type: 3}
    entranceType: 0
    entranceDuration: 0
    enableReaction: 0
    reactionDuration: 0
    reactionScaleTarget: 0
    enableShake: 0
    shakeIntensity: 0
    shakeDuration: 0
    outroType: 0
    outroDuration: 0
    customEntranceClip: {fileID: 0}
    optionalUIImage: {fileID: 0}
    soundClip: {fileID: 0}
    typingSFX: {fileID: 0}
    useBlackScreen: 0
    excludeDialogueBoxFromBlackout: 0
    hideDialoguePanel: 0
    openNameInputAfterThisLine: 0
  - character: {fileID: 0}
    useCustomSpeakerName: 0
    customSpeakerName: Emby
    dialogueText: Please don't tell Sienna.
    filipinoText: Pakiusap... huwag mong sabihin kay Sienna. Ma lilintikan ako hehe~
    useItalic: 0
    useBold: 0
    emotionPortrait: {fileID: 4613369332385885323, guid: c38f36071605f5c4da5011c8238f182b, type: 3}
    entranceType: 0
    entranceDuration: 0
    enableReaction: 0
    reactionDuration: 0
    reactionScaleTarget: 0
    enableShake: 0
    shakeIntensity: 0
    shakeDuration: 0
    outroType: 0
    outroDuration: 0
    customEntranceClip: {fileID: 0}
    optionalUIImage: {fileID: 0}
    soundClip: {fileID: 0}
    typingSFX: {fileID: 0}
    useBlackScreen: 0
    excludeDialogueBoxFromBlackout: 0
    hideDialoguePanel: 0
    openNameInputAfterThisLine: 0
  - character: {fileID: 0}
    useCustomSpeakerName: 1
    customSpeakerName: 
    dialogueText: 'You notice something glowing and floating towards you. '
    filipinoText: May napansin kang isang kumikislap na bagay na dahan-dahang lumulutang
      papunta sa'yo."
    useItalic: 1
    useBold: 0
    emotionPortrait: {fileID: 0}
    entranceType: 0
    entranceDuration: 0
    enableReaction: 0
    reactionDuration: 0
    reactionScaleTarget: 0
    enableShake: 0
    shakeIntensity: 0
    shakeDuration: 0
    outroType: 0
    outroDuration: 0
    customEntranceClip: {fileID: 0}
    optionalUIImage: {fileID: 0}
    soundClip: {fileID: 0}
    typingSFX: {fileID: 0}
    useBlackScreen: 0
    excludeDialogueBoxFromBlackout: 0
    hideDialoguePanel: 0
    openNameInputAfterThisLine: 0
  - character: {fileID: 0}
    useCustomSpeakerName: 0
    customSpeakerName: Emby
    dialogueText: Oh! A recipe page! This must have gotten scattered when the tower
      locked!
    filipinoText: Oh! Isang recipe page! Siguradong nagkalat ito nang makandado ang
      tore!
    useItalic: 0
    useBold: 0
    emotionPortrait: {fileID: 21300000, guid: 66b1fa522f7127144aa490ad162fbccd, type: 3}
    entranceType: 0
    entranceDuration: 0
    enableReaction: 1
    reactionDuration: 0
    reactionScaleTarget: 0
    enableShake: 0
    shakeIntensity: 0
    shakeDuration: 0
    outroType: 0
    outroDuration: 0
    customEntranceClip: {fileID: 0}
    optionalUIImage: {fileID: 0}
    soundClip: {fileID: 0}
    typingSFX: {fileID: 0}
    useBlackScreen: 0
    excludeDialogueBoxFromBlackout: 0
    hideDialoguePanel: 0
    openNameInputAfterThisLine: 0
  - character: {fileID: 0}
    useCustomSpeakerName: 0
    customSpeakerName: Emby
    dialogueText: ...Sinabawang Gulay? That's it? Just... vegetables in soup...
    filipinoText: '"...Sinabawang Gulay? Iyon na ''yon? Gulay lang... sa sabaw...'
    useItalic: 0
    useBold: 0
    emotionPortrait: {fileID: 3955470843362796982, guid: 4756c828401aeb64e8c9554097ccd465, type: 3}
    entranceType: 0
    entranceDuration: 0
    enableReaction: 1
    reactionDuration: 0
    reactionScaleTarget: 0
    enableShake: 0
    shakeIntensity: 0
    shakeDuration: 0
    outroType: 0
    outroDuration: 0
    customEntranceClip: {fileID: 0}
    optionalUIImage: {fileID: 0}
    soundClip: {fileID: 0}
    typingSFX: {fileID: 0}
    useBlackScreen: 0
    excludeDialogueBoxFromBlackout: 0
    hideDialoguePanel: 0
    openNameInputAfterThisLine: 0
  - character: {fileID: 0}
    useCustomSpeakerName: 0
    customSpeakerName: Emby
    dialogueText: My head was hurting investigating this tower and the treasure was
      SOUP?!
    filipinoText: Isinugal ko ang buhay ko sa pag-iimbestiga sa toreng ito, tapos
      ang kayamanan ay... SABAW?!
    useItalic: 0
    useBold: 1
    emotionPortrait: {fileID: 1615358792748342469, guid: 055b9bfce4569d3429157f68e4a9f001, type: 3}
    entranceType: 0
    entranceDuration: 0
    enableReaction: 0
    reactionDuration: 0
    reactionScaleTarget: 0
    enableShake: 1
    shakeIntensity: 1.5
    shakeDuration: 1.5
    outroType: 0
    outroDuration: 0
    customEntranceClip: {fileID: 0}
    optionalUIImage: {fileID: 0}
    soundClip: {fileID: 0}
    typingSFX: {fileID: 0}
    useBlackScreen: 0
    excludeDialogueBoxFromBlackout: 0
    hideDialoguePanel: 0
    openNameInputAfterThisLine: 0
  - character: {fileID: 0}
    useCustomSpeakerName: 0
    customSpeakerName: 
    dialogueText: Sienna will be happy over this though, so let's bring it back.
    filipinoText: Pero matutuwa si Sienna rito, kaya ibalik na natin ito.
    useItalic: 0
    useBold: 0
    emotionPortrait: {fileID: 21300000, guid: 1077e0627b8da5f44bb82b1ccf6fecf2, type: 3}
    entranceType: 0
    entranceDuration: 0
    enableReaction: 0
    reactionDuration: 0
    reactionScaleTarget: 0
    enableShake: 0
    shakeIntensity: 0
    shakeDuration: 0
    outroType: 0
    outroDuration: 0
    customEntranceClip: {fileID: 0}
    optionalUIImage: {fileID: 0}
    soundClip: {fileID: 0}
    typingSFX: {fileID: 0}
    useBlackScreen: 0
    excludeDialogueBoxFromBlackout: 0
    hideDialoguePanel: 0
    openNameInputAfterThisLine: 0
  - character: {fileID: 0}
    useCustomSpeakerName: 0
    customSpeakerName: Emby
    dialogueText: "Anyway! A true hero helps others without hesitation \u2014 that's
      what I believe! Here,take this key. Let's go report back to Sienna!"
    filipinoText: "Sige na nga! Ang tunay na bayani ay tumutulong sa iba nang walang
      pag-aalinlangan\u2014 'yan ang paniniwala ko! Heto, kunin mo ang susing ito.
      Tara, bumalik na tayo kay Sienna!"
    useItalic: 0
    useBold: 0
    emotionPortrait: {fileID: -9156928245328908291, guid: ad399d33a18e4de45b38d760f4e88dbf, type: 3}
    entranceType: 0
    entranceDuration: 0
    enableReaction: 0
    reactionDuration: 0
    reactionScaleTarget: 0
    enableShake: 0
